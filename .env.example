# Google Gemini API Key (Get a free key from https://aistudio.google.com/)
GOOGLE_API_KEY=your_gemini_api_key_here

# Backend Settings
HOST=0.0.0.0
PORT=8000
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
VECTOR_STORE_DIR=vector_store

# Frontend API URL (for Docker, use service name; for local development, use 127.0.0.1)
API_URL=http://rag-assistant:8000
